# ---------------------------------------------------------------------------
# OpportunityOS environment configuration
# Copy this file to .env and fill in the values. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma and the app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opportunityos?schema=public"

# Auth.js. Generate a secret with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Set to true when running behind a proxy / on a non-localhost host.
AUTH_TRUST_HOST=true

# AI provider: "anthropic" | "openai" | "mock"
# "mock" runs the whole product with a deterministic, clearly-labelled template
# provider (no API key required). Use it for local development and tests.
AI_PROVIDER="mock"

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"

# AI request rate limit per user (requests per window) for the chat endpoint.
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_SECONDS=600

# Logging: "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"
